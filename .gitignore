/target
# 插件 dll 随仓库分发（宿主以文件是否存在判断装没装），*.incoming 只是导入时的中转文件
/plugin/*.incoming
/tools/*
# 发布/更新相关脚本要入库（其余 tools 下内容如 mingw64 工具链仍忽略）
!/tools/update_server.py
!/tools/publish_drop.bat
/dist/
/testdata/
*.log
build.done
/*.png
# 图标源文件需要入库（build.rs 与 make_ico.ps1 依赖它生成 ico）
!/rabbit.png
# 右下角贴图同样要入库（app.rs 用 include_bytes! 嵌进 exe）
!/mascot.png
# 本机 IDE / 构建环境配置
/.idea/
/.cargo/
__pycache__/
# 本地开发笔记
src/.workbuddy/

# WorkBuddy 本机项目备忘
/.workbuddy/
